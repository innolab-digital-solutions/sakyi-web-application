# -----------------------------------------------------------------------------
# Frontend Application Environment Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Sakyi Health and Wellness"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="https://sakyihealthandwellness.com"

# -----------------------------------------------------------------------------
# Backend API Environment Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_DOMAIN_ENDPOINT="https://api.sakyihealthandwellness.com"
NEXT_PUBLIC_API_VERSION_ENDPOINT="https://api.sakyihealthandwellness.com/v1"

# -----------------------------------------------------------------------------
# Optional: Proxy optimistic session hint (Sanctum / same-site cookies only)
# -----------------------------------------------------------------------------
# One cookie name, or several comma-separated (any match allows the request through).
# Names must be what the browser sends on requests to THIS Next.js origin.
# If set, /admin/* (except /admin/login) redirects to login when none of these cookies exist.
# Leave unset when the session cookie is API-host-only — use RouteGuard + /me only.
# PROXY_ADMIN_SESSION_COOKIE_NAMES="sakyi_backend_session"
# PROXY_ADMIN_SESSION_COOKIE_NAMES="sakyi_backend_session,other_cookie"

# -----------------------------------------------------------------------------
# CI / E2E (Playwright) Environment Variables
# -----------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# Optional: align with playwright.config.ts when 3000 is already in use
# PLAYWRIGHT_TEST_PORT="3001"

# -----------------------------------------------------------------------------
# Sentry (optional — no events when DSN is unset or Sentry is disabled)
# -----------------------------------------------------------------------------
# Hard off (keeps @sentry/nextjs in the app; no init, no capture, no quota use):
# NEXT_PUBLIC_SENTRY_ENABLED="false"
# NEXT_PUBLIC_SENTRY_DSN="https://...@....ingest.sentry.io/..."
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="staging"
# NEXT_PUBLIC_SENTRY_RELEASE="sakyi-web@1.0.0"
# Budget overrides (0–1). Defaults are tiered by NEXT_PUBLIC_APP_ENV.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE="0"
# NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE="0.2"
# NEXT_PUBLIC_SENTRY_ENABLE_LOGS="false"